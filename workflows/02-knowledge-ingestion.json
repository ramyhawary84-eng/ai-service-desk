    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://your-cluster.cloud.qdrant.io/collections/it_service_desk_kb/points/delete?wait=true",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "qdrantApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ (() => {\n  const article = $json.knowledge_article;\n\n  const pageId = String(article?.page_id ?? '').trim();\n  const spaceId = String(article?.space_id ?? '').trim();\n  const sourceUrl = String(article?.source_url ?? '').trim();\n\n  const expectedUrl =\n    'https://your-site.atlassian.net/wiki/spaces/IS/pages/' + pageId;\n\n  if (\n    !/^\\d+$/.test(pageId) ||\n    spaceId !== 'YOUR_CONFLUENCE_SPACE_ID' ||\n    !(\n      sourceUrl === expectedUrl ||\n      sourceUrl.startsWith(expectedUrl + '/')\n    )\n  ) {\n    throw new Error(\n      'Cleanup stopped: missing or unexpected Confluence page identity.'\n    );\n  }\n\n  return {\n    filter: {\n      must: [\n        {\n          key: 'metadata.page_id',\n          match: { value: pageId }\n        },\n        {\n          key: 'metadata.space_id',\n          match: { value: spaceId }\n        }\n      ]\n    }\n  };\n})() }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        2176,
        112
      ],
      "id": "e4263f72-2cf9-4c40-a4f4-1d86082e075f",
      "name": "Remove Previous Article Chunks"
    },
    {
