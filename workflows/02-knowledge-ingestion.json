        "assignments": {
          "assignments": [
            {
              "id": "8f8ad2d7-f042-4eab-b9a4-b66bf94ff444",
              "name": "knowledge_article",
              "value": "={{ (() => {\n  if (\n    $json.status !== 'ok' ||\n    $json.result?.status !== 'completed'\n  ) {\n    throw new Error('Qdrant did not confirm article cleanup.');\n  }\n\n  return $('Process Knowledge Articles').item.json.knowledge_article;\n})() }}",
              "type": "object"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
