    },
    {
      "parameters": {
        "operation": "extractHtmlContent",
        "dataPropertyName": "page.body.storage.value",
        "extractionValues": {
          "values": [
            {
              "key": "article_text",
              "cssSelector": "body"
            },
            {
              "key": "metadata_text",
              "cssSelector": "body > p:first-child"
            }
          ]
        },
        "options": {
          "trimValues": true,
          "cleanUpText": false
        }
      },
      "type": "n8n-nodes-base.html",
      "typeVersion": 1.2,
      "position": [
        672,
        0
      ],
      "id": "b5477aa3-5503-4bd3-a69f-b47406cc853d",
      "name": "HTML"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "f5804c24-a462-4f80-9b94-629728736ded",
              "name": "knowledge_article",
              "value": "={{ (() => {\n  const page = $('Split Out Articles').item.json.page ?? {};\n  const text = String($json.article_text ?? '').trim();\n  const lines = String($json.metadata_text ?? '')\n    .split(/\\r?\\n/)\n    .map(line => line.trim());\n  const errors = [];\n\n  const readField = (label) => {\n    const prefix = label + ':';\n    const matches = lines.filter(line => line.startsWith(prefix));\n\n    if (matches.length !== 1) {\n      errors.push(label + ': missing or repeated');\n      return '';\n    }\n\n    const value = matches[0].slice(prefix.length).trim();\n    if (!value) errors.push(label + ': empty');\n    return value;\n  };\n\n  const articleId = readField('Article ID');\n  const categoryLabel = readField('Category');\n  const approval = readField('Knowledge approval').toLowerCase();\n  const autoResponse = readField('Automatic response allowed').toLowerCase();\n\n  const categories = {\n    'account/access': 'account_access',\n    'vpn/network': 'vpn_network',\n    'email/collaboration': 'email_collaboration',\n    'hardware/peripherals': 'hardware_peripherals',\n    'software/applications': 'software_applications'\n  };\n\n  const categoryKey = categoryLabel.toLowerCase().replace(/\\s*\\/\\s*/g, '/');\n  const category = Object.keys(categories).includes(categoryKey)\n    ? categories[categoryKey]\n    : 'unclear';\n\n  const pageId = String(page.id ?? '');\n  const title = String(page.title ?? '').trim();\n  const version = page.version?.number;\n  const path = String(page._links?.webui ?? '');\n  const sourceUrl = path.startsWith('/spaces/')\n    ? 'https://your-site.atlassian.net/wiki' + path\n    : '';\n\n  if (!/^KB-\\d+$/.test(articleId))\n    errors.push('Invalid article ID');\n\n  if (category === 'unclear')\n    errors.push('Unknown category');\n\n  if (!['draft', 'approved', 'retired'].includes(approval))\n    errors.push('Unknown approval status');\n\n  if (!['yes', 'no'].includes(autoResponse))\n    errors.push('Automatic response must be Yes or No');\n\n  if (!/^\\d+$/.test(pageId))\n    errors.push('Missing or invalid Confluence page ID');\n\n  if (!title)\n    errors.push('Missing page title');\n\n  if (String(page.spaceId ?? '') !== 'YOUR_CONFLUENCE_SPACE_ID')\n    errors.push('Unexpected Confluence space');\n\n  if (!Number.isInteger(version) || version < 1)\n    errors.push('Missing or invalid page version');\n\n  if (!sourceUrl)\n    errors.push('Missing source link');\n\n  if (page.status !== 'current')\n    errors.push('Page is not published');\n\n  if (!text)\n    errors.push('Article text is empty');\n\n  const eligible = errors.length === 0 && approval === 'approved';\n\n  return {\n    article_id: articleId,\n    page_id: pageId,\n    title,\n    source_url: sourceUrl,\n    source_version: Number.isInteger(version) ? version : null,\n    space_id: String(page.spaceId ?? ''),\n    category,\n    knowledge_approval: approval,\n    automatic_response_allowed: eligible && autoResponse === 'yes',\n    text,\n    validation_errors: errors,\n    index_eligible: eligible,\n    exclusion_reason: errors.length\n      ? errors.join('; ')\n      : (eligible ? '' : 'Knowledge approval is ' + approval + '.')\n  };\n})() }}",
              "type": "object"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
        896,
